# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Groq API ключ для парсинга дат (llama-3.1-8b-instant)
GROQ_API_KEY=

# Твой Telegram ID (куда падают уведомления о записях)
ADMIN_TELEGRAM_ID=YOUR_TELEGRAM_ID

# Путь к Google Service Account JSON (скачивается из Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# ID календаря (обычно твой gmail, или найти в настройках Google Calendar)
GOOGLE_CALENDAR_ID=

# Часовой пояс
TIMEZONE=Europe/Moscow

# Рабочие часы (МСК)
WORK_HOUR_START=9
WORK_HOUR_END=18

# Минимальный буфер до записи (часов)
MIN_HOURS_BEFORE=2

# За сколько дней вперёд показывать слоты
SLOTS_DAYS_AHEAD=7
