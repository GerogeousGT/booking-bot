# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# LLM для парсинга дат из свободного текста ("завтра в 15", "в пятницу утром").
# Провайдер переключается одной строкой, см. services/llm_provider.py.
# proxyapi (по умолчанию, gpt-4o-mini) | groq
LLM_PROVIDER=proxyapi
# Пусто = дефолтная модель провайдера
LLM_MODEL=

# ProxyAPI — основной провайдер (OpenAI-совместимый)
PROXYAPI_KEY=
PROXYAPI_BASE_URL=https://api.proxyapi.ru/openai/v1

# Groq — запасной провайдер (LLM_PROVIDER=groq)
GROQ_API_KEY=

# Твой Telegram ID (куда падают уведомления о записях)
ADMIN_TELEGRAM_ID=YOUR_TELEGRAM_ID

# Путь к Google Service Account JSON (скачивается из Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# ID календаря (обычно твой gmail, или найти в настройках Google Calendar)
GOOGLE_CALENDAR_ID=

# Часовой пояс
TIMEZONE=Europe/Moscow

# Рабочие часы (МСК)
WORK_HOUR_START=9
WORK_HOUR_END=18

# Минимальный буфер до записи (часов)
MIN_HOURS_BEFORE=2

# За сколько дней вперёд показывать слоты
SLOTS_DAYS_AHEAD=7
